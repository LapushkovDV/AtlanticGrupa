cmPick:
{
  message('0-2');
 if Inherited::handleevent(cmPick) = heAbort  {
    //stop;abort;exit;
  }
  message('0-3');
  case curfield of
  #pullingOrg: {
     var _cOrg : comp = extAttr.cogetattr(coBaseDoc, BaseDoc.nRec,'Пуллинг. ФРЦ доставки');
